{
  "name": "dsh-voice-mode-custom",
  "version": "0.7.38-custom.1",
  "description": "Custom edition of dsh-voice-mode 0.7.38 with a standalone sidebar settings page, responsive layout, and desktop worker fixes.",
  "license": "MIT",
  "type": "module",
  "main": "./plugin/dsh-voice-mode/lib/index.js",
  "exports": {
    ".": "./plugin/dsh-voice-mode/lib/index.js",
    "./client": "./plugin/dsh-voice-mode/lib/client.js",
    "./cordis.patch.yml": "./plugin/dsh-voice-mode/cordis.patch.yml",
    "./locale/*.json": "./plugin/dsh-voice-mode/locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./plugin/dsh-voice-mode/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuhe888/dsh-voice-mode-custom.git"
  },
  "homepage": "https://github.com/wuhe888/dsh-voice-mode-custom#readme",
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.1-rc.2 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "voice-mode",
    "speech",
    "asr",
    "tts",
    "speech-to-text",
    "text-to-speech",
    "speech-recognition",
    "full-duplex",
    "barge-in",
    "captions",
    "local-asr",
    "on-device"
  ],
  "dsh": {
    "bundle": {
      "patch": "./plugin/dsh-voice-mode/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "node -e \"console.error('不要在仓库根目录发布：npm 包在 plugin/dsh-voice-mode 下发布。'); process.exit(1)\"",
    "build": "pnpm --dir plugin/dsh-voice-mode build",
    "typecheck": "pnpm --dir plugin/dsh-voice-mode typecheck",
    "test": "pnpm --dir plugin/dsh-voice-mode test",
    "test:custom": "pnpm --dir plugin/dsh-voice-mode test:custom"
  },
  "bugs": {
    "url": "https://github.com/wuhe888/dsh-voice-mode-custom/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "sherpa-onnx": "^1.13.6",
    "sherpa-onnx-node": "1.13.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "files": [
    "plugin/dsh-voice-mode/lib",
    "plugin/dsh-voice-mode/cordis.patch.yml",
    "plugin/dsh-voice-mode/locale",
    "plugin/dsh-voice-mode/icon.svg",
    "plugin/dsh-voice-mode/LICENSE",
    "plugin/dsh-voice-mode/THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "README.md"
  ]
}
